<% layout("/layouts/boilerplate") %>
<h3>All Listings</h3>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
  <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="col listing-card">
      <div class="card h-100 listing-card">
        <% const imageUrl = listing.image && typeof listing.image === 'string' ? listing.image : (listing.image && listing.image.url) || 'https://plus.unsplash.com/premium_photo-1789437506518-b7837e8a18e4?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D'; %>
        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="width: 20rem" />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %> </b><br>
            <% const safePrice = listing.price ?? 0; %>
            &#8377; <%= Number(safePrice).toLocaleString("en-IN") %> /night
          </p>
        </div>
      </div>
    </div>
    </a>
    
  <% } %>
</div>

