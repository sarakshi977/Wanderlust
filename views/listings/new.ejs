<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2">
        <br><br>
        <h3>Create a New List</h3>
        <% if (error && error.length > 0) { %>
            <div class="alert alert-danger"><%= error[0] %></div>
        <% } %>
        <form method="POST" action="/listings" novalidate class="needs-validation" encType="multipart/form-data">

            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input id="title" name="listing[title]"
                 value="<%= listing && listing.title ? listing.title : '' %>" 
                 placeholder="Add a catchy title" 
                 type="text" 
                 class="form-control" 
                 required />
                <div class="valid-feedback">Title looks good!</div>
                <!-- <div class="invalid-feedback d-block"><%= typeof errors !== 'undefined' && errors && errors.title ? errors.title : 'Title is required.' %></div> -->
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea name="listing[description]" 
                placeholder="enter description" 
                class="form-control" 
                required></textarea>
                <div class="invalid-feedback">Please enter a valid description!</div>
            </div>
            
            <!-- <div class="mb-3">
                <label for="image" class="form-label">Image Link</label>
                <input name="listing[image]" 
                value="<%= listing && listing.image ? listing.image : '' %>" 
                placeholder="Enter image URL/Link" 
                type="url" 
                class="form-control  
                required <%= typeof errors !== 'undefined' && errors && errors.image ? 
                'is-invalid' : '' %>" />
                <!-- <div class="invalid-feedback d-block"><%= typeof errors !== 'undefined' && errors && errors.image ? errors.image : 'Please enter a valid image URL!' %></div> -->
            <!-- </div> --> 

            <div class="mb-3">
                <label for="image" class="form-label">Upload Image </label>
                <input name="listing[image]" 
                value="<%= listing && listing.image ? listing.image : '' %>"  
                type="file" 
                class="form-control  
                required <%= typeof errors !== 'undefined' && errors && errors.image ? 
                'is-invalid' : '' %>" />
                <!-- <div class="invalid-feedback d-block"><%= typeof errors !== 'undefined' && errors && errors.image ? errors.image : 'Please enter a valid image URL!' %></div> -->
            </div>
            <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" 
                    value="<%= listing && listing.price ? listing.price : '' %>" 
                    placeholder="1200"  
                    class="form-control <%= typeof errors !== 'undefined' && errors && errors.price ? 
                    'is-invalid' : '' %>" 
                    required/>
                    <div class="invalid-feedback">Please enter a valid price!</div>
                </div>
                
                <div class="mb-3 col-md-8">
                    <label for="country" class="form-label">Country</label>
                    <input name="listing[country]" 
                    value="<%= listing && listing.country ? listing.country : '' %>" 
                    placeholder="California" 
                    type="text" 
                    pattern="[A-Za-z ]{2,}" 
                    title="Use letters and spaces only" 
                    class="form-control <%= typeof errors !== 'undefined' && errors && errors.country ? 
                    'is-invalid' : '' %>" 
                    required />
                    <div class="invalid-feedback">Please enter a valid country name!</div>
                </div>
            </div>

            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                    <input name="listing[location]" 
                    value="<%= listing && listing.location ? listing.location : '' %>" 
                    placeholder="Silicon Valley" 
                    type="text" pattern="(?=.*[A-Za-z])[A-Za-z0-9 ,.-]{2,}" 
                    class="form-control <%= typeof errors !== 'undefined' && errors && errors.location ? 
                    'is-invalid' : '' %>" 
                    required/>
                    <div class="invalid-feedback" >Please enter a valid location!</div>
            </div>
            <br><br>
            <button class="btn btn-dark add-btn">Add</button>
            <br><br><br>
        </form>
    </div>
</div>